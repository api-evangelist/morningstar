                {
                  "disabled": false,
                  "type": "any",
                  "value": "0P000003MH",
                  "key": "companyIdentifier",
                  "description": "(Required) Unique identifier of a company. Valid values are performance ID or `exchange:ticker` value."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "company_report",
                  "key": "reportType",
                  "description": "(Required) Type of report"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "latest",
                  "key": "reportView",
                  "description": "(Required) View of report. Currently, only `latest` is supported."
                }
              ]
