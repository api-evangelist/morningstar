          "id": "6e92ceab-80db-4064-b08c-9b0a04d5f04e",
          "name": "Get a company-related report",
          "request": {
            "name": "Get a company-related report",
            "description": {
              "content": "Get the **most recent** version of a company-related report for the company specified in the `companyIdentifier` parameter. You can identify a company using a performance ID (for example,`0P00012BBI`)  or `exchange:ticker` value, (for example, `XNAS:GOOG`). </br></br>  The following document types can be retrieved using this endpoint:\n  </br></br> - Company Report</br> - Stock Analyst Note</br>- Valuation Model</br>- Thematic Research</br></br>A URL returned in the response is used to access the document file.\n  </br></br>**Note** To get current and historical company-related research documents, use\n  the **equity - rps document** endpoints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "equity",
                "v1",
                ":companyIdentifier",
                ":reportType",
                ":reportView"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
