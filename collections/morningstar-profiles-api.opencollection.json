{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts profiles API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get household profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/profiles",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit number of records returned. Default is 100 or 500."
              },
              {
                "name": "skip",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Return the total count of profiles. Default is `false`."
              }
            ]
          },
          "docs": "Get household profiles for an advisor. To limit the number of records returned in the response, use the `limit` parameter."
        }
      ]
    }
  ],
  "bundled": true
}