          "name": "Get statement details",
          "request": {
            "name": "Get statement details",
            "description": {
              "content": "Get the portfolio statement information extracted by the `POST /statement-details` request. </br></br>The unique job ID returned by the POST request is automatically included in this GET request's URL. \n</br></br>The response contains a JSON obect with an array of security details such as ticker, name, market value, and so on.",
              "type": "text/plain"
            },
            "url": {
