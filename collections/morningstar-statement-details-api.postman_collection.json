        {
          "id": "b8d9f110-702a-4d57-a319-da3858a7cfaa",
          "name": "Extract statement details",
          "request": {
            "name": "Extract statement details",
            "description": {
              "content": "Extract portfolio statement information from the base64-encoded PDF/image sent in the request. Information is extracted based on the logic defined, where available, for the custodian specified in the `documentShortName` or `documentName` values in the request body.</br></br>The request supports the following file types:</br></br> -JPG </br> -JPEG</br> - PNG </br> - PDF </br></br>When sending a PDF, you can specify the page numbers to extract information from. For example, `1,3,6,9` or `1,3,6,8-11`. If you do not specify `pageNumbers` values, the whole document will be considered. If you pass a `0` value, it will be considered as `1`. When specifying a range, for example `8-11`, the first number must be smaller than the second number. </br></br>The response contains an `id` which you use to retrieve the results of the request. The `id` can also be used to track the request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "statement-details"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Language and locale",
                "key": "Accept-Language",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"<string>\",\n  \"pageNumbers\": \"<string>\",\n  \"documentType\": \"<string>\",\n  \"documentName\": \"<string>\",\n  \"documentShortName\": \"DEFAULT\",\n  \"data\": \"<byte>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
