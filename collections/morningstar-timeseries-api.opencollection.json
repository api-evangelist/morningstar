{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts timeseries API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "timeseries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get statistics in timeseries format for a namespace, tool and time period",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/v1/timeseries/:namespace/:tool/:period",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Get statistics for this namespace"
              },
              {
                "name": "tool",
                "value": "",
                "type": "path",
                "description": "Get statistics for this tool"
              },
              {
                "name": "period",
                "value": "",
                "type": "path",
                "description": "Get statistics for this time period"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Get statistics logged on or after this date"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "Get statistics logged on or before this date"
              }
            ]
          },
          "docs": "Get latest statistics in timeseries format for the specified namespace, tool and time period.\n\n. You can specify a date range for the query."
        }
      ]
    }
  ],
  "bundled": true
}