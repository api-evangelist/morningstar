          "name": "Get an Environmental, Social, and Governance (ESG) Report",
          "request": {
            "name": "Get an Environmental, Social, and Governance (ESG) Report",
            "description": {
              "content": "Get an ESG Report for the fund shareclass specified in the `fundshareclassId` parameter.</br></br>To override the default value in the Accept-Language HTTP header, use the `locale` parameter. </br></br>In the `pageSize` parameter, you can specify the page size for the returned PDF. Page size options are `Letter` or `A4`.</br></br>If a report exists, a presigned URL from which you can download the PDF is returned in the response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fund",
                "v1",
                "reports",
                "esg",
                ":fundshareclassId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "analyst-rating",
                  "value": "0",
                  "description": "Include Morningstar Analyst Ratings data point in report"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "Letter",
                  "description": "Page size of output PDF"
                },
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "en-US",
                  "description": "Language and locale, for example, en-US"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "F00000UPC2",
                  "key": "fundshareclassId",
                  "description": "(Required) Unique identifier of a fund shareclass"
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a52c8bf5-38c1-4271-b619-1d046160e492",
