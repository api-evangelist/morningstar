          "id": "8591311c-9945-48a8-a36c-f3fd8fc8a3a1",
          "name": "Get a Quantitative Report",
          "request": {
            "name": "Get a Quantitative Report",
            "description": {
              "content": "Get a Quantitative Report for the company specified in the `companyIdentifier` parameter. Quantitative Reports provide a detailed assessment of a company based on a quantitative analysis using a variety of company financial data and other data inputs. </br></br>You can identify a company using a performance ID (for example,`0P00012BBI`)  or `exchange:ticker` value, (for example, `XNAS:GOOG`). </br></br>To override the default value in the Accept-Language HTTP header, use the `locale` parameter. </br></br>In the `pageSize` parameter, you can specify the page size for the returned PDF. Page size options are `Letter` or `A4`.</br></br> A URL returned in the response is used to access the document file.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "equity",
                "v1",
                "reports",
                "quant",
                ":companyIdentifier"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "Letter",
                  "description": "Page size of output PDF"
                },
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "en-US",
                  "description": "Language and locale, for example, en-US"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "0P000003MH",
                  "key": "companyIdentifier",
                  "description": "(Required) Unique identifier of a company. Valid values are performance ID or `exchange:ticker` value."
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
