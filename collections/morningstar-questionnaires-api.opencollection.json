            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of a questionnaire"
              }
            ]
          },
          "docs": "Get questions and possible options for the risk tolerance questionnaire. Questions and options can be stored for future requests. There are two versions of the questionnaire.\n"
