          "id": "287715cf-2931-46dc-837c-7fee4407a53f",
          "name": "Calculate returns forecast for a fund based on a custom macro shock scenario",
          "request": {
            "name": "Calculate returns forecast for a fund based on a custom macro shock scenario",
            "description": {
              "content": "Based on a specific risk model and custom macro shock scenario, calculate returns forecast for a fund. The response will include data for the historical returns, return during and after shock, and expected volatility.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "macro-shock-scenarios",
                ":scenario_id",
                "calculate-forecast-return"
              ],
