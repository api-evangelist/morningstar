{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts exposures API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "exposures",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Calculate active exposure for investment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.us-api.morningstar.com/token/exposures/snapshot",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Based on a specific risk model, calculate active exposure for a specific investment or portfolio. The most recent data will be returned."
        }
      ]
    }
  ],
  "bundled": true
}