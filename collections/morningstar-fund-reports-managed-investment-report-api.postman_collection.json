          "request": {
            "name": "Get a Managed Investment Report",
            "description": {
              "content": "Get a Managed Investment Report for the fund specified in the `FundIdentifier` parameter.</br></br> Managed Investments Reports provide a qualitative assessment  of a fund carried out by Morningstar Research Analysts.</br></br>In the `pageSize` parameter, you can specify the page size for the returned PDF. Page size options are `Letter` or `A4`.</br></br>If a report exists, a presigned URL from which you can download the PDF is returned in the response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fund",
                "v1",
                "reports",
                "global-fund-report",
                ":FundIdentifier"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "Letter",
                  "description": "Page size of output PDF"
                },
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "en-US",
                  "description": "Language and locale, for example, en-US"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "FOUSA00J4N",
                  "key": "FundIdentifier",
                  "description": "(Required) Unique identifier of a fund"
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
