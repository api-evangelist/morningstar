{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts households API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "households",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get household IDs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/households",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Get all household IDs for an advisor. The household ID can be used with the Portfolios API to return information about household accounts."
        }
      ]
    }
  ],
  "bundled": true
}