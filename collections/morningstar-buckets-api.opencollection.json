{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts buckets API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "buckets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get buckets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/buckets",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Get all buckets."
        },
        {
          "info": {
            "name": "Get a bucket",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/buckets/:bucketId",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "bucketId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of a bucket"
              }
            ]
          },
          "docs": "Get the bucket specified in the `bucketId` parameter."
        }
      ]
    }
  ],
  "bundled": true
}