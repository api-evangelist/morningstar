          "name": "Get a statistics resource for a namespace, tool and time period",
          "request": {
            "name": "Get a statistics resource for a namespace, tool and time period",
            "description": {
              "content": "Get the latest statistics for the specified namespace, tool and time period. Specify the `date` parameter to get statistics for that date.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "statistics",
                ":namespace",
                ":tool",
                ":period"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<date>",
                  "description": "Get statistics logged for this date. For month or quarter this is the end date for the period. If omitted returns the latest available statistics."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "namespace",
                  "description": "(Required) Get statistics for this namespace"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "tool",
                  "description": "(Required) Get statistics for this tool"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "period",
                  "description": "(Required) Get statistics for this time period"
                }
              ]
            },
            "header": [
