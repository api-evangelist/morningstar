      "item": [
        {
          "id": "7cb833f6-6671-4766-9405-dc4bdab39632",
          "name": "Get an Investment Details Report",
          "request": {
            "name": "Get an Investment Details Report",
            "description": {
              "content": "Get an Investment Details Report for the securities specified in the `securities` parameter.  Reports are generated in PDF format. You can specify that the PDF opens online or is downloaded as an attachment. </br></br>Use the `currencyId` parameter to define the currency of the data in the report. To override the default value in the Accept-Language HTTP header, use the `langcult` parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "IDR"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "securities",
                  "value": "FOUSA05H5F",
                  "description": "(Required) Securities to query. Separate multiple entries with ',' or '|'."
                },
                {
                  "disabled": false,
                  "key": "currencyId",
                  "value": "<string>",
                  "description": "ISO 4217 code. For example 'USD'."
                },
                {
                  "disabled": false,
                  "key": "langcult",
                  "value": "en-US",
                  "description": "(Required) Language and locale, for example, en-US"
                },
                {
                  "disabled": false,
                  "key": "contentDispositionHeaderValue",
                  "value": "attachment",
                  "description": "Open PDF online or download as an attachment"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "method": "GET",
            "auth": null
          },
