{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts Positions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Positions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a collection of all positions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/positions",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of records per page"
              }
            ]
          },
          "docs": "Get a collection of all positions. You can specify the number of the page to return and the number of records per page."
        }
      ]
    }
  ],
  "bundled": true
}