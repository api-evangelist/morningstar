                  "disabled": false,
                  "key": "startDate",
                  "value": "<date>",
                  "description": "Get statistics logged on or after this date"
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<date>",
                  "description": "Get statistics logged on or before this date"
                }
              ],
              "variable": [
