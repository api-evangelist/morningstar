              {
                "name": "ignoreSections",
                "value": "YOUR_DIFFERENCES,FOOTNOTES",
                "type": "query",
                "description": "Determines the sections NOT to include in the report.If not specified, all the sections will be included. Multiple valuses must be comma-separated."
              }
