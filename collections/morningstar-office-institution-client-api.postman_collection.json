              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": {\n    \"institutionName\": \"<string>\",\n    \"institutionType\": \"<string>\",\n    \"institutionId\": \"<string>\",\n    \"isUSCorporation\": \"<string>\",\n    \"taxIdType\": \"<string>\",\n    \"dateOfIncorporation\": \"<date>\",\n    \"incorporationState\": \"<string>\",\n    \"address1\": \"<string>\",\n    \"address2\": \"<string>\",\n    \"address3\": \"<string>\",\n    \"city\": \"<string>\",\n    \"state\": \"<string>\",\n    \"zipCode\": \"<string>\",\n    \"phone\": \"<string>\",\n    \"fax\": \"<string>\"\n  },\n  \"primaryContact\": {\n    \"firstName\": \"<string>\",\n    \"lastName\": \"<string>\",\n    \"role\": \"<string>\",\n    \"title\": \"<string>\",\n    \"dateOfBirth\": \"<date>\",\n    \"socialSecurityNumber\": \"<string>\",\n    \"email\": \"<string>\",\n    \"workPhone\": \"<string>\",\n    \"cellPhone\": \"<string>\"\n  }\n}",
