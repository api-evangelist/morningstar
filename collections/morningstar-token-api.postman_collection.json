          "name": "Generate a JSON Web Token (JWT)",
          "request": {
            "name": "Generate a JSON Web Token (JWT)",
            "description": {
              "content": "Authenticates a client using HTTP Basic Auth and returns a signed JWT\nbearer token for use in subsequent API requests.\n\nPass your credentials as a Base64-encoded `username:password` string in\nthe `Authorization` header. The returned `access_token` should be included\nas a `Bearer` token in the `Authorization` header of all authenticated requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "token",
                "oauth"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST"
          },
          "response": [
            {
              "id": "f225c51f-947e-496b-bfb8-cec36da2ce6c",
              "name": "200: OK",
