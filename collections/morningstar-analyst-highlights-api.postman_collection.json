          "id": "94be9f76-4334-47a2-b987-d1964415f4e8",
          "name": "Retrieve analyst highlights.",
          "request": {
            "name": "Retrieve analyst highlights.",
            "description": {
              "content": "When the asynchronous processing job is completed, this endpoint is returned in the `Location` header of the `302 Found` response returned by the `/jobs/{jobId}` endpoint.\n\n  When this endpoint is called, it returns:\n\n  * The AI insights for the investments it successfully identifies and where data is available.\n  * A metadata object listing any input identifiers that could not be matched or for which no data is available.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "direct-web-services",
                "v1",
                "ai-insights",
                "results",
                ":resultId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "resultId",
                  "description": "(Required) "
