            "name": "Retrieve portfolio holdings date",
            "description": {
              "content": "This endpoint is used to retrieve dates for which data is available for a portfolio.\n\nThese dates are used to specify a portfolio date when requesting investment details for the following views:\n\n- `full-look-through-portfolio-holdings`\n- `full-portfolio-holdings-month-end-or-quarter-end-most-recent`",
              "type": "text/plain"
            },
            "url": {
