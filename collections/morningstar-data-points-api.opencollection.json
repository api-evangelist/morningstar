{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts Data Points API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Data Points",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List available data points.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/direct-web-services/v1/investment-list/data-points"
          },
          "docs": "List available data points."
        },
        {
          "info": {
            "name": "List all equity data points.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/direct-web-services/v1/screeners/equities/data-points"
          },
          "docs": "Returns the list of equity data points supported for screener queries. Metadata returned for each entry includes the operators supported."
        },
        {
          "info": {
            "name": "List all managed investment data points.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/direct-web-services/v1/screeners/managed-investments/data-points"
          },
          "docs": "Returns the list of managed investment data points supported for screener queries. Metadata returned for each entry includes the operators supported."
        }
      ]
    }
  ],
  "bundled": true
}