          "id": "34ba8d6a-9cfe-4f44-afcb-3aeec5897814",
          "name": "Get the table content of the investment mix question",
          "request": {
            "name": "Get the table content of the investment mix question",
            "description": {
              "content": "The 'Investment Mix' question (question 8 of FM10S30 and question 16 of FM25V30) prompts the client to choose from a list of seven example portfolio options, selecting the one that best aligns with their preferred investment mix. These options range from low-risk/low-return to high-risk/high-return, with variations in between. The question text includes a link to an image depicting the investment mix table. Additionally, the content can be accessed as a JSON object via this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "portfolios",
                "investments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
