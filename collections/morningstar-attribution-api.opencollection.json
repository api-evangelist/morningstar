{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts attribution API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "attribution",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Calculate performance attribution for a portfolio over a defined time period",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.us-api.morningstar.com/token/attribution/calculate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Based on a specific risk model, calculate performance attribution for a specific portfolio or fund over a time period of between 3 months and 15 years.  The response enables you to attribute  returns to specific factors."
        }
      ]
    }
  ],
  "bundled": true
}