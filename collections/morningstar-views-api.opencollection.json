{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts Views API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Views",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List views",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/direct-web-services/v1/investments/views"
          },
          "docs": "Retrieve the list of data views your account is entitled to access,\nalong with the corresponding `viewId` values required to request\ninvestment details."
        },
        {
          "info": {
            "name": "Retrieve a view definition",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/direct-web-services/v1/investments/views/:viewId",
            "params": [
              {
                "name": "viewId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a view definition"
        }
      ]
    }
  ],
  "bundled": true
}