                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"investments\": [\n    {\n      \"id\": \"0C00000378\",\n      \"idType\": \"companyId\"\n    },\n    {\n      \"id\": \"0C00000D9W\",\n      \"idType\": \"companyId\"\n    },\n    {\n      \"id\": \"0C00000L88\",\n      \"idType\": \"companyId\"\n    }\n  ],\n  \"sortBy\": [\n    \"filingUpdatedAt\"\n  ],\n  \"orderBy\": \"desc\"\n}",
                  "options": {
