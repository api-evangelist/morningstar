{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts BenchmarkFees API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "BenchmarkFees",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get retirement plan benchmark fees",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.us-api.morningstar.com/token/v1/retirementplan/BenchmarkFees"
          },
          "docs": "Get a list of standard retirement plan benchmark fees. The response will return a list of all benchmark fee models the user is entitled for. No parameters are required to be passed for this API."
        }
      ]
    }
  ],
  "bundled": true
}