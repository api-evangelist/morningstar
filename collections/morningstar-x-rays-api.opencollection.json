{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authorization Tokens Accounts x-rays API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "x-rays",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate portfolio x-rays",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.us-api.morningstar.com/token/xray",
            "params": [
              {
                "name": "langcult",
                "value": "",
                "type": "query",
                "description": "Language and locale, for example, en-US"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate an x-ray of the portfolio(s) specified in the request body. The response will return information about how the portfolio is diversified by region, sector and investment style.</br></br>To override the default value in the Accept-Language HTTP header, use the `langcult` parameter."
        }
      ]
    }
  ],
  "bundled": true
}