                  {
                    "id": "FOUSA00CFZ",
                    "type": "SecurityId",
                    "weight": 50
                  }
                ]
              }
            ],
            "items": {
              "$ref": "#/components/schemas/Holdings"
            }
          }
        },
        "type": "object"
      },
      "Holdings": {
