            "type": "string",
            "description": "Currency of holdings",
            "example": "USD"
          },
          "investment": {
            "description": "",
            "example": {
              "id": "model-portfolio1",
              "type": "portfolio"
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/idType"
              }
            ]
          },
          "benchmark": {
            "description": "",
            "example": {
