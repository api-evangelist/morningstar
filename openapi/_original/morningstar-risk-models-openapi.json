        "properties": {
          "portfolios": {
            "type": "array",
            "example": [
              {
                "id": "test1",
                "holdings": [
                  {
                    "id": "0P0000058R",
                    "type": "PerformanceId",
                    "weight": 60
                  },
                  {
                    "id": "0P000001RB",
                    "type": "PerformanceId",
                    "weight": 40
                  }
                ]
              },
              {
                "id": "test2",
                "holdings": [
                  {
                    "id": "0P0000058R",
                    "type": "PerformanceId",
                    "weight": 50
