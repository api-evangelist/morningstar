        "description": "Updates a client profile </br></br> `clientName`, `firstName`, and `lastName` do not support these characters: ~!#^`[]{}|\\;\"<>?/",
        "operationId": "updateClient",
        "requestBody": {
          "description": "The client to update.",
          "required": true,
