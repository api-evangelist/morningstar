          "lastName": {
            "type": "string",
            "format": "string",
            "maxLength": 50,
            "example": "Client"
          },
          "address1": {
            "type": "string",
            "format": "string",
            "maxLength": 50,
            "example": "22 W. Washington St."
          },
          "address2": {
            "type": "string",
            "format": "string",
            "maxLength": 50,
            "example": "FL 7"
          },
          "address3": {
            "type": "string",
            "format": "string",
            "maxLength": 50,
            "example": "Rm. 700"
          },
          "city": {
            "type": "string",
            "format": "string",
